# ── App metadata ──────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
SQLITE_DB_URL=sqlite:///./app_metadata.db

# ── Local Compose database service ────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_HOST_PORT=3308
MONGO_HOST_PORT=27018

# ── Migration / dry-run tuning ────────────────────────────────────────────────
BATCH_SIZE=1000
DRY_RUN_SAMPLE_SIZE=10000
DOCKER_DSN_REWRITE=false
