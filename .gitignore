# ── Environment files ──────────────────────────────────────────────────────
.env
.env.local
.env.*.local
!.env.example

# ── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/
*.cover

# ── SQLite / app metadata ──────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
app_metadata.db

# ── Alembic (keep versions, ignore local artifacts if any) ────────────────
# (versions/ folder itself should stay tracked — nothing extra to ignore here)

# ── Node / React / Vite ─────────────────────────────────────────────────────
node_modules/
dist/
build/
.vite/
*.local

# npm/yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Docker ──────────────────────────────────────────────────────────────────
# (docker-compose.yml and Dockerfiles should stay tracked — nothing to ignore)

