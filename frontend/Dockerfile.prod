# Step 1: Build React App
FROM node:20-alpine AS build
WORKDIR /app

ARG VITE_MYSQL_HOST_PORT=3308
ARG VITE_MONGO_HOST_PORT=27018
ENV VITE_MYSQL_HOST_PORT=$VITE_MYSQL_HOST_PORT
ENV VITE_MONGO_HOST_PORT=$VITE_MONGO_HOST_PORT

COPY package*.json ./
RUN npm install

COPY . .
# Empty VITE_API_URL so frontend uses relative "/api", routed via Nginx
ENV VITE_API_URL=""
RUN npm run build

# Step 2: Serve with Nginx
FROM nginx:alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

